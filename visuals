local function applySkybox(name)
    for _, sky in ipairs(Lighting:GetChildren()) do
        if sky:IsA("Sky") then sky:Destroy() end
    end
    local atmosphere = Lighting:FindFirstChildOfClass("Atmosphere")
    if atmosphere then atmosphere:Destroy() end

    if name == "Default" then
        if OriginalSky then
            local sky = Instance.new("Sky")
            sky.Parent = Lighting
            for prop, value in pairs(OriginalSky) do pcall(function() sky[prop] = value end) end
        end
        return
    end

    local data = Skyboxes[name]
    if not data then return end

    local sky = Instance.new("Sky")
    sky.Parent = Lighting
    for prop, value in pairs(data) do pcall(function() sky[prop] = value end) end
    sky.SkyboxOrientation = Vector3.new(0, 0, 0)
end

local function startSkyEnforce()
    if SkyEnforceConnection then SkyEnforceConnection:Disconnect() end
    SkyEnforceConnection = RunService.Heartbeat:Connect(function()
        if Library.Flags["SkyEnable"] and Library.Flags["SkyEnable"].Value then
            if not Lighting:FindFirstChildOfClass("Sky") then applySkybox(CurrentSkyName) end
        end
    end)
end
