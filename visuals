local function setAllMaterials(material)
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("BasePart") and not obj:IsDescendantOf(game.Players) then
            if not OriginalMaterials[obj] then OriginalMaterials[obj] = obj.Material end
            pcall(function() obj.Material = material end)
        end
    end
end

local function restoreMaterials()
    for part, mat in pairs(OriginalMaterials) do
        if part and part.Parent then pcall(function() part.Material = mat end) end
    end
    table.clear(OriginalMaterials)
end

MaterialRefreshConnection = workspace.DescendantAdded:Connect(function(obj)
    if MaterialEnabled and obj:IsA("BasePart") and not obj:IsDescendantOf(game.Players) then
        if not OriginalMaterials[obj] then OriginalMaterials[obj] = obj.Material end
        pcall(function() obj.Material = CurrentMaterial end)
    end
end)

-- ====================== FOG ======================
local function setFog(enabled, color)
    local atm = Lighting:FindFirstChildOfClass("Atmosphere")
    if atm then atm:Destroy() end
    if enabled then
        Lighting.FogStart = 0; Lighting.FogEnd = 250
        if color then Lighting.FogColor = color end
    else
        Lighting.FogStart = 0; Lighting.FogEnd = 100000
    end
end

-- ====================== SKY SPIN ======================
local function toggleSkySpin(enabled, speed)
    if SkySpinConnection then SkySpinConnection:Disconnect(); SkySpinConnection = nil end
    if enabled then
        local sky = Lighting:FindFirstChildOfClass("Sky")
        if not sky then sky = Instance.new("Sky"); sky.Parent = Lighting end
        SkySpinConnection = RunService.RenderStepped:Connect(function(dt)
            local current = sky.SkyboxOrientation
            sky.SkyboxOrientation = Vector3.new(current.X, (current.Y + (speed or SkySpinSpeed) * dt) % 360, current.Z)
        end)
    end
end

-- ====================== SKIN CHANGER FUNCTIONS ======================
local function ClearAdded(Handle)
    for _, Obj in Handle:GetChildren() do
        if Obj:GetAttribute('SkinClone') then Obj:Destroy() end
    end
end

local function ApplySkin(Tool, GunName, SkinName)
    if SkinName == "None" then RestoreSkin(Tool); return end
    local Handle = Tool:FindFirstChild('Handle')
    if not Handle then return end
    local Tag = Handle:FindFirstChild('SkinTag')
    if Tag and Tag.Value == SkinName then return end
    
    if not Handle:GetAttribute('OrigTexture') then
        Handle:SetAttribute('OrigTexture', Handle.TextureID)
        Handle:SetAttribute('OrigColor', Handle.Color)
        Handle:SetAttribute('OrigMaterial', Handle.Material.Value)
        Handle:SetAttribute('OrigTransparency', Handle.Transparency)
    end
    ClearAdded(Handle)
    if not Tag then Tag = Instance.new('StringValue'); Tag.Name = 'SkinTag'; Tag.Parent = Handle end
    Tag.Value = SkinName

    local WrapGun = ReplicatedStorage:FindFirstChild('Wraps')
    WrapGun = WrapGun and WrapGun:FindFirstChild(GunName)
    local Wrap = WrapGun and WrapGun:FindFirstChild(SkinName)
    if not Wrap then return end

    local WrapClone = Wrap:Clone()
    local WrapHandle = WrapClone:FindFirstChild('Handle')
    if not WrapHandle then WrapClone:Destroy() return end

    local BaseCF = WrapHandle.CFrame
    for _, Obj in WrapHandle:GetChildren() do
        if Obj:IsA('Sound') or Obj:IsA('BillboardGui') then continue end
        if Obj:IsA('BasePart') then
            local Offset = BaseCF:ToObjectSpace(Obj.CFrame)
            Obj.Anchored = false; Obj.CanCollide = false; Obj.Massless = true
            Obj.CFrame = Handle.CFrame * Offset
            for _, W in Obj:GetChildren() do
                if W:IsA('Weld') or W:IsA('WeldConstraint') then W:Destroy() end
            end
            local Weld = Instance.new('Weld')
            Weld.Name = 'SkinWeld'; Weld.Part0 = Handle; Weld.Part1 = Obj
            Weld.C0 = Offset; Weld:SetAttribute('SkinClone', true); Weld.Parent = Obj
        end
        Obj:SetAttribute('SkinClone', true)
        Obj.Parent = Handle
    end
    Handle.TextureID = WrapHandle.TextureID
    Handle.Color = WrapHandle.Color
    Handle.Material = WrapHandle.Material
    Handle.Transparency = WrapHandle.Transparency
    WrapClone:Destroy()
end

local function RestoreSkin(Tool)
    local Handle = Tool:FindFirstChild('Handle')
    if not Handle then return end
    local Tag = Handle:FindFirstChild('SkinTag')
    if not Tag then return end
    ClearAdded(Handle)
    local OrigTex = Handle:GetAttribute('OrigTexture')
    local OrigColor = Handle:GetAttribute('OrigColor')
    local OrigMat = Handle:GetAttribute('OrigMaterial')
    local OrigTrans = Handle:GetAttribute('OrigTransparency')
    if OrigTex then Handle.TextureID = OrigTex end
    if OrigColor then Handle.Color = OrigColor end
    if OrigMat then Handle.Material = OrigMat end
    if OrigTrans then Handle.Transparency = OrigTrans end
    Tag:Destroy()
end

local function ApplyBeamChanger()
    local Config = getgenv().HoodCustoms['BeamChanger']
    if not Config['Enabled'] or Config['Beam'] == 'None' then return end
    if BeamApplied == Config['Beam'] then return end
    local DataFolder = LocalPlayer:FindFirstChild('DataFolder')
    if not DataFolder then return end
    local InventoryData = DataFolder:FindFirstChild('InventoryData')
    if not InventoryData then return end
    local BulletBeams = InventoryData:FindFirstChild('BulletBeams')
    local EquippedBulletBeams = DataFolder:FindFirstChild('EquippedBulletBeams')
    if BulletBeams and BulletBeams:IsA('StringValue') then
        local BulletData = {}
        for _, Hash in BeamHashes do BulletData[Hash] = { Name = Config['Beam'] } end
        BulletBeams.Value = HttpService:JSONEncode(BulletData)
    end
    if EquippedBulletBeams and EquippedBulletBeams:IsA('StringValue') then
        local EquippedData = {}
        for Weapon, Hash in BeamHashes do EquippedData['[' .. Weapon .. ']'] = Hash end
        EquippedBulletBeams.Value = HttpService:JSONEncode(EquippedData)
    end
    BeamApplied = Config['Beam']
end

local Reloading = false
local function FastReload()
    local Config = getgenv().HoodCustoms['FastReload']
    if not Config['Enabled'] or Reloading then return end
    local Char = LocalPlayer.Character
    if not Char then return end
    local Tool = Char:FindFirstChildOfClass('Tool')
    if not Tool then return end
    local Script = Tool:FindFirstChild('Script')
    if not Script then return end
    local Ammo = Script:FindFirstChild('Ammo')
    local MaxAmmo = Script:FindFirstChild('MaxAmmo')
    if not Ammo or not MaxAmmo then return end
    local ClientAmmo = Ammo:FindFirstChild('CLIENT')
    if not ClientAmmo then return end
    if ClientAmmo.Value > 0 then return end
    local BodyEffects = Char:FindFirstChild('BodyEffects')
    local ReloadingFlag = BodyEffects and BodyEffects:FindFirstChild('Reloading_CLIENT')
    Reloading = true
    ReplicatedStorage.MainEvent:FireServer('Reload', Tool)
    task.wait(Config['ReloadTime'])
    ClientAmmo.Value = MaxAmmo.Value
    if ReloadingFlag then ReloadingFlag.Value = false end
    Reloading = false
end

